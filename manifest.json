{
  "id": "rtl-table-widget",
  "version": "1.0.0",
  "name": "RTL Table Widget",
  "description": "Custom table widget with native right-to-left support for Hebrew and Arabic",
  "icon": "table",
  "vendor": "Internal",
  "eula": "",
  "license": "",
  "newInstancePrefix": "RtlTable",
  "shellVersion": "2023.20",
  "l10n": {},
  "webcomponents": [
    {
      "kind": "main",
      "tag": "rtl-table-widget",
      "url": "https://github.com/szino-boop/sac_Widgets/main.js",
      "integrity": ""
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Title shown above the table",
      "default": "טבלה"
    },
    "textDirection": {
      "type": "string",
      "description": "Text direction: rtl or ltr",
      "default": "rtl"
    },
    "showStatusBadges": {
      "type": "boolean",
      "description": "Show colored status pills in the status column",
      "default": true
    },
    "enableSelection": {
      "type": "boolean",
      "description": "Allow selecting rows via checkbox",
      "default": true
    },
    "enableSearch": {
      "type": "boolean",
      "description": "Show the search box above the table",
      "default": true
    }
  },
  "methods": {
    "getSelectedKeys": {
      "description": "Returns an array of currently selected row keys",
      "returnType": "any"
    },
    "clearSelection": {
      "description": "Clears all row selections"
    },
    "refresh": {
      "description": "Forces the widget to re-render from the current data binding"
    }
  },
  "events": {
    "onRowSelect": {
      "description": "Fired when the set of selected rows changes"
    },
    "onSort": {
      "description": "Fired when the user sorts by a column"
    }
  },
  "dataBindings": {
    "myDataBinding": {
      "feed": "dataBinding",
      "type": "dimensionsAndMeasures"
    }
  }
}
